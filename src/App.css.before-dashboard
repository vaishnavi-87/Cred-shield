* {
  box-sizing: border-box;
}

:root {
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;

  color: #f4f7fb;
  background: #070a10;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(
      circle at 50% -15%,
      rgba(93, 105, 255, 0.18),
      transparent 34%
    ),
    radial-gradient(
      circle at 90% 45%,
      rgba(65, 214, 157, 0.05),
      transparent 30%
    ),
    #070a10;
}

/* ============================================================
   BASE
   ============================================================ */

button,
input {
  font: inherit;
}

button {
  -webkit-tap-highlight-color: transparent;
}

.app {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.background-glow {
  position: fixed;
  width: 720px;
  height: 720px;
  top: -390px;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: rgba(91, 104, 255, 0.13);
  filter: blur(120px);
  pointer-events: none;
  z-index: 0;
}

.container {
  position: relative;
  z-index: 1;
  width: min(1040px, calc(100% - 36px));
  margin: 0 auto;
  padding: 24px 0 72px;
}

/* ============================================================
   HERO
   ============================================================ */

.hero {
  text-align: center;
  padding: 26px 0 32px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  margin-bottom: 18px;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.025em;
}

.brand-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: linear-gradient(145deg, #ffffff, #dce2ff);
  color: #080b12;
  font-size: 18px;
  font-weight: 900;
  box-shadow:
    0 10px 35px rgba(103, 117, 255, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.network-badge {
  display: flex;
  align-items: center;
  gap: 7px;
  width: fit-content;
  margin: 0 auto 25px;
  padding: 7px 12px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.035);
  color: #aeb7c8;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.network-badge::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #65e5a9;
  box-shadow: 0 0 12px rgba(101, 229, 169, 0.8);
}

.hero h1 {
  margin: 0;
  font-size: clamp(42px, 7vw, 72px);
  line-height: 1;
  letter-spacing: -0.06em;
  font-weight: 850;
}

.hero h1 span {
  background: linear-gradient(100deg, #aeb8ff, #8a98ff 55%, #73e7b0);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-description {
  max-width: 690px;
  margin: 24px auto 0;
  color: #929bad;
  font-size: 16px;
  line-height: 1.75;
}

/* ============================================================
   PRIVACY BANNER
   ============================================================ */

.privacy-banner {
  display: flex;
  gap: 15px;
  align-items: flex-start;
  padding: 18px 20px;
  margin: 8px 0 18px;
  border: 1px solid rgba(133, 147, 255, 0.16);
  border-radius: 18px;
  background:
    linear-gradient(
      135deg,
      rgba(101, 116, 255, 0.09),
      rgba(255, 255, 255, 0.025)
    );
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.025),
    0 15px 45px rgba(0, 0, 0, 0.08);
}

.privacy-icon {
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: rgba(132, 146, 255, 0.1);
  font-size: 18px;
}

.privacy-banner strong {
  display: block;
  margin: 1px 0 5px;
  color: #e8ecf6;
  font-size: 14px;
}

.privacy-banner p {
  margin: 0;
  color: #8d96a9;
  font-size: 13px;
  line-height: 1.6;
}

/* ============================================================
   MAIN CARD
   ============================================================ */

.main-card {
  display: grid;
  gap: 14px;
}

/* Wallet + verification cards */

.wallet-section,
.verification-card {
  padding: 27px;
  border: 1px solid rgba(255, 255, 255, 0.085);
  border-radius: 22px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.055),
      rgba(255, 255, 255, 0.018)
    );
  backdrop-filter: blur(18px);
  box-shadow:
    0 22px 65px rgba(0, 0, 0, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);
}

.wallet-section {
  position: relative;
}

.wallet-section::before,
.verification-card::before {
  content: "";
  display: block;
  width: 42px;
  height: 2px;
  margin-bottom: 18px;
  border-radius: 999px;
  background: #8794ff;
  opacity: 0.7;
}

.verification-card::before {
  background: #67dba6;
}

/* ============================================================
   WALLET
   ============================================================ */

.wallet-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 14px 16px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  background: rgba(255, 255, 255, 0.035);
  color: #aab3c5;
  font-size: 13px;
}

.wallet-status.success {
  border-color: rgba(77, 220, 120, 0.18);
  background: rgba(77, 220, 120, 0.055);
  color: #a7f5bf;
}

.wallet-status.error {
  border-color: rgba(255, 80, 100, 0.18);
  background: rgba(255, 80, 100, 0.055);
  color: #ffabb7;
}

.wallet-status .label {
  display: block;
  margin-bottom: 4px;
  color: #697387;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.wallet-status strong {
  color: #e4e8f1;
  font-size: 14px;
}

.status-pill {
  white-space: nowrap;
  padding: 6px 9px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.045);
  color: #778196;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.status-pill.connected {
  background: rgba(79, 220, 145, 0.08);
  color: #82e6b0;
}

.wallet-address {
  margin: 15px 0;
  padding: 14px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 13px;
  background: rgba(0, 0, 0, 0.18);
}

.wallet-address span {
  display: block;
  margin-bottom: 6px;
  color: #697387;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.wallet-address code {
  display: block;
  color: #dce2f1;
  font-size: 11px;
  overflow-wrap: anywhere;
}

.wallet-hint {
  margin: 12px 0 0;
  color: #6f798d;
  font-size: 11px;
  line-height: 1.6;
}

/* ============================================================
   BUTTONS
   ============================================================ */

.primary-button,
.prove-button,
.secondary-button {
  width: 100%;
  padding: 14px 18px;
  border: 0;
  border-radius: 13px;
  cursor: pointer;
  font-weight: 750;
  transition:
    transform 0.18s ease,
    opacity 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.primary-button,
.prove-button {
  background: linear-gradient(135deg, #ffffff, #e8ecff);
  color: #080b12;
  box-shadow:
    0 9px 26px rgba(255, 255, 255, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.primary-button:hover:not(:disabled),
.prove-button:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow:
    0 13px 32px rgba(255, 255, 255, 0.1),
    0 0 0 4px rgba(137, 151, 255, 0.06);
}

.secondary-button {
  color: #e5e9f3;
  background: rgba(255, 255, 255, 0.065);
  border: 1px solid rgba(255, 255, 255, 0.07);
}

.secondary-button:hover:not(:disabled) {
  transform: translateY(-2px);
  background: rgba(255, 255, 255, 0.09);
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.48;
}

/* ============================================================
   PRIVATE INPUTS
   ============================================================ */

.private-inputs {
  display: grid;
  gap: 14px;
  margin: 22px 0;
  text-align: left;
}

.private-inputs label {
  display: grid;
  gap: 8px;
  color: #a2abbd;
  font-size: 11px;
  font-weight: 700;
}

.private-inputs input {
  width: 100%;
  padding: 14px 15px;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 12px;
  outline: none;
  background: rgba(0, 0, 0, 0.2);
  color: #eef1f8;
  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.private-inputs input::placeholder {
  color: #596274;
}

.private-inputs input:focus {
  border-color: rgba(137, 151, 255, 0.48);
  background: rgba(0, 0, 0, 0.26);
  box-shadow: 0 0 0 4px rgba(112, 126, 255, 0.07);
}

.private-inputs input:disabled {
  opacity: 0.55;
}

/* Remove number input arrows */

.private-inputs input::-webkit-outer-spin-button,
.private-inputs input::-webkit-inner-spin-button {
  margin: 0;
  -webkit-appearance: none;
}

.private-inputs input[type="number"] {
  -moz-appearance: textfield;
}

/* ============================================================
   VERIFICATION CARD
   ============================================================ */

.verification-card h2 {
  margin: 0;
  color: #f1f4fa;
  font-size: 20px;
  letter-spacing: -0.025em;
}

.verification-card > p {
  margin: 8px 0 0;
  max-width: 720px;
  color: #818b9e;
  font-size: 13px;
  line-height: 1.65;
}

.disabled-card {
  opacity: 0.85;
}

.section-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  margin-bottom: 16px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.035);
  font-size: 18px;
}

.privacy-list {
  display: grid;
  gap: 8px;
  margin: 18px 0;
  padding: 14px;
  border: 1px solid rgba(103, 219, 166, 0.09);
  border-radius: 13px;
  background: rgba(103, 219, 166, 0.025);
}

.privacy-list span {
  color: #91b5a4;
  font-size: 11px;
}

.proof-status {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  margin-top: 17px;
  padding: 15px;
  border: 1px solid rgba(137, 151, 255, 0.15);
  border-radius: 14px;
  background: rgba(111, 126, 255, 0.055);
}

.proof-status strong {
  display: block;
  margin-bottom: 5px;
  color: #e2e6f5;
  font-size: 13px;
}

.proof-status span {
  display: block;
  margin-top: 3px;
  color: #7f899e;
  font-size: 11px;
  line-height: 1.5;
}

.spinner,
.status-spinner {
  flex: 0 0 auto;
  animation: spin 1s linear infinite;
}

.spinner {
  width: 19px;
  height: 19px;
  margin-top: 1px;
  border: 2px solid rgba(255, 255, 255, 0.12);
  border-top-color: #aab5ff;
  border-radius: 50%;
}

.status-spinner {
  display: inline-block;
}

/* ============================================================
   SUCCESS / ERROR
   ============================================================ */

.success-card {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  margin-top: 18px;
  padding: 18px;
  border: 1px solid rgba(77, 220, 120, 0.18);
  border-radius: 15px;
  background:
    linear-gradient(
      135deg,
      rgba(77, 220, 120, 0.075),
      rgba(255, 255, 255, 0.018)
    );
}

.success-icon {
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: rgba(77, 220, 120, 0.1);
  color: #8df0bd;
  font-weight: 900;
}

.success-card strong {
  display: block;
  margin: 1px 0 5px;
  color: #baf6d1;
  font-size: 14px;
}

.success-card span {
  display: block;
  color: #82988b;
  font-size: 11px;
  line-height: 1.55;
}

.success-card .privacy-note {
  margin-top: 7px;
  color: #a0c4ad;
}

.error-message {
  margin-top: 16px;
  padding: 13px 14px;
  border: 1px solid rgba(255, 80, 100, 0.17);
  border-radius: 12px;
  background: rgba(255, 80, 100, 0.055);
  color: #ffabb7;
  font-size: 12px;
  line-height: 1.55;
}

/* ============================================================
   VERIFICATION STATUS
   ============================================================ */

.verification-status {
  border: 1px solid rgba(130, 140, 255, 0.16) !important;
  background:
    linear-gradient(
      145deg,
      rgba(20, 26, 55, 0.86),
      rgba(10, 14, 27, 0.82)
    ) !important;
  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.025);
}

.verification-status h3 {
  color: #dce1f0;
  font-size: 14px;
  letter-spacing: -0.01em;
}

/* ============================================================
   PRIVACY MODEL
   ============================================================ */

.privacy-model {
  margin-top: 28px;
  padding: 26px 0 0;
}

.privacy-model h2 {
  margin: 0 0 15px;
  color: #dce1ec;
  font-size: 15px;
  font-weight: 750;
  letter-spacing: -0.015em;
}

.privacy-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.privacy-grid > div {
  position: relative;
  min-height: 86px;
  padding: 17px;
  border: 1px solid rgba(255, 255, 255, 0.065);
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.025);
}

.privacy-grid span {
  display: block;
  margin-bottom: 9px;
  color: #6f798d;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.13em;
}

.privacy-grid strong {
  font-size: 14px;
  letter-spacing: -0.01em;
}

.privacy-grid > div:not(.public-result)::after {
  content: "HIDDEN";
  position: absolute;
  right: 13px;
  top: 14px;
  padding: 4px 6px;
  border-radius: 6px;
  background: rgba(156, 169, 255, 0.07);
  color: #7e8bd1;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.public-result {
  border-color: rgba(77, 220, 120, 0.17) !important;
  background:
    linear-gradient(
      145deg,
      rgba(77, 220, 120, 0.06),
      rgba(255, 255, 255, 0.018)
    ) !important;
}

.public-result span {
  color: #6ca77d;
}

.public-result::after {
  content: "ON-CHAIN";
  position: absolute;
  right: 13px;
  top: 14px;
  padding: 4px 6px;
  border-radius: 6px;
  background: rgba(77, 220, 120, 0.08);
  color: #7edb98;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

/* ============================================================
   FOOTER
   ============================================================ */

footer {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 42px;
  padding-top: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.07);
  color: #606a7d;
  font-size: 11px;
}

footer p {
  margin: 0;
}

/* ============================================================
   ANIMATION
   ============================================================ */

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 800px) {
  .privacy-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 650px) {
  .container {
    width: min(100% - 22px, 960px);
    padding-top: 14px;
    padding-bottom: 45px;
  }

  .hero {
    padding-top: 18px;
  }

  .hero h1 {
    font-size: clamp(38px, 12vw, 55px);
  }

  .hero-description {
    margin-top: 19px;
    font-size: 14px;
    line-height: 1.65;
  }

  .wallet-section,
  .verification-card {
    padding: 21px;
    border-radius: 18px;
  }

  .privacy-banner {
    padding: 16px;
  }

  .privacy-grid {
    grid-template-columns: 1fr;
  }

  .wallet-status {
    align-items: flex-start;
  }

  .status-pill {
    margin-top: 2px;
  }

  footer {
    flex-direction: column;
  }
}