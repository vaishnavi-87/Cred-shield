pragma language_version >= 0.23;

import CompactStandardLibrary;

/*
 * CRED SHIELD — LEVEL 4 MVP
 *
 * Privacy-preserving creditworthiness verification.
 *
 * PRIVACY MODEL:
 *
 * PRIVATE INPUTS:
 * - creditScore()
 * - dti()
 * - bankBalance()
 *
 * These values are supplied as private witnesses.
 * They are used inside the zero-knowledge circuit and
 * are NOT stored as public ledger state.
 *
 * PUBLIC STATE:
 * - verified: whether the borrower satisfies all
 *   predefined creditworthiness conditions.
 *
 * PROOF:
 * The circuit checks the private financial inputs against
 * the eligibility thresholds without revealing their
 * exact values.
 *
 * DISCLOSURE:
 * Only the final eligibility result is deliberately
 * disclosed to the public ledger.
 *
 * Therefore, an observer can verify that the borrower
 * satisfies the required conditions without learning:
 * - the exact credit score
 * - the exact debt-to-income ratio
 * - the exact bank balance
 * - the private witness values
 */
export ledger verified: Boolean;

witness creditScore(): Uint<32>;
witness dti(): Uint<32>;
witness bankBalance(): Uint<64>;

export circuit verifyCreditworthiness(): [] {
    const score = creditScore();
    const debtToIncome = dti();
    const balance = bankBalance();

    const scoreEligible = score >= 700 as Uint<32>;
    const dtiEligible = debtToIncome <= 40 as Uint<32>;
    const balanceEligible = balance >= 1000 as Uint<64>;

    const isEligible =
        scoreEligible && dtiEligible && balanceEligible;

    verified = disclose(isEligible);
}
